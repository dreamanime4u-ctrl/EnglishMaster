
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#08BDF5"
                android:centerColor="#DDF8FF"
                android:endColor="#72D92E"/>
        </shape>
    </item>

    <item
        android:gravity="bottom"
        android:height="180dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#8BEA38"
                android:endColor="#39B916"/>
        </shape>
    </item>

</layer-list>
